// src/i18n/translations.ts
//
// Central dictionary for DumaSafeGuide's language support.
// Add new languages by adding a new top-level key (matching the
// `LanguageCode` type below) and mirroring the same nested shape
// as `en`. Add new pages by adding a new top-level section
// (e.g. `map`, `directory`, `safetyTips`).
//
// ⚠️ Note: ticker.alerts strings are safety-critical. Machine/AI
// translation is a solid starting point, but have a native speaker
// review these specific strings before relying on them in production.

export type TranslationDict = {
  common: {
    live: string;
    emergency: string;
    quickAccess: string;
    explore: string;
  };
  nav: {
    directory: string;
    map: string;
    safetyTips: string;
    about: string;
    resources: string;
    myDashboard: string;
    responderPanel: string;
