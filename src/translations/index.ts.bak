    privacy: {
      breadcrumbResources: "Mga Mapagkukunan",
      breadcrumbTerms: "Mga Tuntunin ng Serbisyo",
      breadcrumbCurrent: "Patakaran sa Privacy",
      eyebrow: "Datos at Privacy",
      titleLine1: "Patakaran sa",
      titleAccent: "Privacy",
      heroSub: "Pinahahalagahan ng DumaSafeGuide ang iyong privacy. Kinokolekta lang namin ang kinakailangan para paganahin ang pag-uulat ng emerhensiya at mga serbisyo para sa kaligtasan ng komunidad.",
      meta: "Petsa ng Pagkakaroon ng Bisa: Enero 1, 2025 · Huling Update: Hunyo 2025",
      introStrong: "Hindi kailanman ipinagbibili ang iyong datos.",
      introRest: "Ang impormasyong kinokolekta sa pamamagitan ng DumaSafeGuide ay ginagamit lamang para mag-ugnay ng tugon sa emerhensiya at mapabuti ang mga feature ng kaligtasan ng platform. Hindi ito ibinabahagi sa mga komersyal na third party maliban kung hinihingi ng batas ng Pilipinas o para suportahan ang mga awtorisadong tagatugon sa emerhensiya.",
      collectHeading: "Impormasyong Kinokolekta Namin",
      collectItems: {
        auth: { label: "Batayang detalye ng user para sa pagpapatunay", detail: "Pangalan, email address, at impormasyon sa pakikipag-ugnayan na ibinigay sa pagpaparehistro ng account, na ginagamit lamang para patunayan ang iyong pagkakakilanlan sa platform." },
        reports: { label: "Mga ulat ng emerhensiya na isinumite sa sistema", detail: "Datos ng lokasyon, paglalarawan ng insidente, mga larawan, at timestamp na naka-attach sa anumang ulat ng emerhensiya na isinampa mo sa DumaSafeGuide." },
        feedback: { label: "Feedback na kusang loob na ibinigay", detail: "Mga rating, mungkahi, o komento na pipiliin mong isumite upang matulungan kaming mapabuti ang pagtugon at usability ng platform." },
      },
      usageHeading: "Paggamit ng Datos",
      usageItems: {
        improve: { label: "Pagpapabuti ng functionality ng sistema", detail: "Ang naipon at anonymized na datos ay tumutulong sa amin na matukoy ang mga bottleneck sa pagproseso ng ulat at mapabuti ang oras ng pagtugon sa iba't ibang barangay." },
        support: { label: "Suporta sa mga tagatugon sa emerhensiya", detail: "Ang mga kaugnay na detalye ng insidente ay ibinabahagi sa awtorisadong tauhan ng CDRRMO, BFP, at Red Cross upang mag-ugnay ng tugon sa lugar ng pangyayari." },
        awareness: { label: "Pagpapahusay ng kamalayan sa kaligtasan ng publiko", detail: "Ang trend na datos mula sa mga naiulat na insidente ay maaaring ilathala sa anonymized na anyo upang matulungan ang komunidad na maunawaan ang mga lokal na pattern ng panganib." },
      },
      rightsHeading: "Ang Iyong mga Karapatan",
      rightsItems: {
        access: { label: "Karapatang Ma-access", detail: "Maaari kang humiling ng kopya ng lahat ng personal na datos na hawak namin tungkol sa iyo anumang oras sa pamamagitan ng pakikipag-ugnayan sa mga administrator ng platform." },
        deletion: { label: "Karapatang Mabura", detail: "Maaari kang humiling na tanggalin ang iyong personal na datos. Ang mga kahilingan ay ipoproseso sa loob ng 30 araw, alinsunod sa mga legal na kinakailangan sa pagpapanatili." },
        correction: { label: "Karapatang Iwasto", detail: "Kung may hindi tamang impormasyon na naka-imbak, maaari kang humiling ng pagwawasto sa pamamagitan ng mga setting ng iyong account o sa pakikipag-ugnayan sa amin nang direkta." },
      },
      noticeStrong: "May katanungan tungkol sa iyong datos?",
      noticeRest: "Makipag-ugnayan sa mga administrator ng DumaSafeGuide sa admin@dumasafeguide.ph o sa pamamagitan ng feedback form ng platform. Ang mga kahilingan sa pagbura ng datos ay ipoproseso sa loob ng 30 araw, alinsunod sa mga legal na obligasyon sa pagpapanatili sa ilalim ng batas ng Pilipinas.",
      ctaHeading: "Kailangan mo bang mag-report ng emerhensiya?",
      ctaSub: "Huwag maghintay — gamitin ang incident reporting form para agad na maabisuhan ang mga lokal na responder.",
      ctaBtn: "Mag-report Ngayon",
