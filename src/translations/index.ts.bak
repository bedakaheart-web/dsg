      sections: {
        responsibilities: {
          tag: "사용자 행동", title: "사용자 책임",
          accurate: { heading: "정확한 정보", body: "사용자는 DumaSafeGuide를 통해 사건 신고, 응급 팁 또는 기타 콘텐츠를 제출할 때 진실하고 정확한 정보를 제공해야 합니다. 불필요한 응급 대응을 유발하는 고의적인 허위 신고는 필리핀 법률상 형사 범죄에 해당할 수 있습니다." },
          appropriate: { heading: "적절한 사용", body: "이 플랫폼은 재난 대비, 응급 대응 조율, 지역사회 안전만을 목적으로 합니다. 개인적인 분쟁, 괴롭힘, 또는 공공 안전과 무관한 목적으로 이 플랫폼을 사용하는 것은 엄격히 금지됩니다." },
          security: { heading: "계정 보안", body: "등록된 계정이 제공된 경우, 사용자는 자신의 인증 정보의 기밀성을 유지할 책임이 있습니다. 계정의 무단 사용은 즉시 DumaSafeGuide 관리자에게 신고해야 합니다." },
        },
        privacy: {
          tag: "데이터 및 개인정보", title: "개인정보 보호정책",
          collect: { heading: "수집하는 데이터", body: "DumaSafeGuide는 사용자가 자발적으로 제출한 위치 데이터, 연락처 정보 및 사건 세부정보를 수집할 수 있습니다. 이 데이터는 응급 조율 목적으로만 사용되며 상업적 제3자에게 판매되거나 공유되지 않습니다." },
          retention: { heading: "데이터 보관", body: "사건 신고 및 사용자가 제출한 데이터는 응급 대응 서비스의 보관, 분석 및 개선을 위해 최대 3년간 보관될 수 있습니다. 사용자는 플랫폼 관리자에게 연락하여 개인 데이터 삭제를 요청할 수 있습니다." },
          thirdParty: { heading: "제3자 공유", body: "정보는 응급 조율 목적으로만 파트너 정부 기관(CDRRMO, BFP, PNP, 필리핀 적십자사)과 공유될 수 있습니다. 사용자의 명시적 동의 없이 민간 상업 단체와 데이터가 공유되지 않습니다." },
        },
        ra10175: {
          tag: "법적 체계", title: "RA 10175 개요",
          act: { heading: "2012년 사이버범죄 예방법", body: "공화국법 10175, 즉 2012년 사이버범죄 예방법은 필리핀에서 온라인 플랫폼의 책임 있는 사용을 규율합니다. DumaSafeGuide는 이 법률을 완전히 준수하여 운영됩니다." },
          prohibited: { heading: "금지된 온라인 행위", body: "RA 10175에 따라 사이버 명예훼손, 신원 도용, 시스템에 대한 불법 접근, 온라인 사기와 같은 행위는 형사 범죄입니다. DumaSafeGuide를 이러한 목적으로 오용하는 사용자는 이 법률에 따라 민사 및 형사 책임을 질 수 있습니다." },
          reporting: { heading: "위반 신고", body: "이 플랫폼에서 RA 10175 또는 기타 관련 법률을 위반하는 콘텐츠나 사용자 행동을 발견하면, 플랫폼의 관리자 연락처를 통해 또는 국가수사국 사이버범죄 부서에 직접 즉시 신고하세요." },
        },
        disclaimer: {
          tag: "면책조항", title: "책임의 제한",
          noGuarantee: { heading: "대응 보장 없음", body: "DumaSafeGuide는 정보 및 조율 지원 도구입니다. 응급 대응 시간이나 결과를 보장하지 않습니다. 생명이 위태로운 상황에서 사용자는 항상 공식 응급 서비스(911, 지역 CDRRMO)에 직접 연락해야 합니다." },
          availability: { heading: "플랫폼 가용성", body: "높은 가용성을 위해 노력하지만 인터넷 인프라에 영향을 미칠 수 있는 극심한 재난 상황에서는 끊김 없는 접근을 보장할 수 없습니다. 항상 오프라인 비상 계획과 바랑가이 단위 연락처를 백업으로 준비하세요." },
          accuracy: { heading: "정보 정확성", body: "모든 정보를 최신 상태로 유지하기 위해 노력하지만, 연락처 번호, 기관 세부정보 및 안전 지침은 변경될 수 있습니다. 중요한 정보에 따라 조치를 취하기 전에 항상 관련 기관에 직접 확인하세요." },
        },
      },
      acceptTitle: "✓ 묵시적 동의",
      acceptBody: "DumaSafeGuide에 접속하고 이용함으로써, 귀하는 본 이용약관과 개인정보 보호정책 전체에 동의하는 것입니다. 계속 이용하는 것은 지속적인 동의를 구성합니다.",
      acceptBadge: "RA 10175 준수",
      ctaHeading: "긴급 상황을 신고해야 하나요?",
      ctaSub: "기다리지 마세요 — 사고 신고 양식을 사용해 즉시 현지 대응요원에게 알리세요.",
      ctaBtn: "지금 신고하기",
    },
  },

