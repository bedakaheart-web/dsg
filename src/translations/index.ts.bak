      titleAccent: "использования",
      sub: "Правила, обязанности и юридическая база, регулирующие использование DumaSafeGuide, включая применимое законодательство Филиппин.",
      meta: "Дата вступления в силу: 1 января 2025 г. · Последнее обновление: июнь 2025 г.",
      tocLabel: "Перейти к разделу",
      sections: {
        responsibilities: {
          tag: "Поведение пользователя", title: "Обязанности пользователя",
          accurate: { heading: "Точная информация", body: "Пользователи обязаны предоставлять правдивую и точную информацию при подаче отчётов о происшествиях, экстренных советов или любого другого контента через DumaSafeGuide. Умышленно ложные отчёты, вызывающие ненужное экстренное реагирование, могут являться уголовным преступлением согласно законодательству Филиппин." },
          appropriate: { heading: "Надлежащее использование", body: "Данная платформа предназначена исключительно для подготовки к чрезвычайным ситуациям, координации экстренного реагирования и обеспечения безопасности сообщества. Использование платформы для личных споров, преследования или любых целей, не связанных с общественной безопасностью, строго запрещено." },
          security: { heading: "Безопасность аккаунта", body: "Если предоставлен зарегистрированный аккаунт, пользователи несут ответственность за сохранение конфиденциальности своих учётных данных. О любом несанкционированном использовании аккаунта необходимо немедленно сообщить администраторам DumaSafeGuide." },
        },
        privacy: {
          tag: "Данные и конфиденциальность", title: "Политика конфиденциальности",
          collect: { heading: "Данные, которые мы собираем", body: "DumaSafeGuide может собирать данные о местоположении, контактную информацию и детали происшествий, добровольно предоставленные пользователями. Эти данные используются исключительно для координации экстренного реагирования и не продаются и не передаются коммерческим третьим лицам." },
          retention: { heading: "Хранение данных", body: "Отчёты о происшествиях и данные, предоставленные пользователями, могут храниться до трёх (3) лет для архивирования, анализа и улучшения услуг экстренного реагирования. Пользователи могут запросить удаление своих персональных данных, обратившись к администраторам платформы." },
          thirdParty: { heading: "Передача третьим лицам", body: "Информация может передаваться партнёрским государственным учреждениям (CDRRMO, BFP, PNP, Филиппинский Красный Крест) исключительно в целях координации экстренного реагирования. Данные не передаются частным коммерческим организациям без явного согласия пользователя." },
        },
        ra10175: {
          tag: "Юридическая база", title: "Обзор RA 10175",
          act: { heading: "Закон о предотвращении киберпреступлений 2012 года", body: "Республиканский закон 10175, или Закон о предотвращении киберпреступлений 2012 года, регулирует ответственное использование онлайн-платформ на Филиппинах. DumaSafeGuide полностью соответствует этому закону." },
          prohibited: { heading: "Запрещённые действия в сети", body: "Согласно RA 10175, такие действия, как клевета в киберпространстве, кража личных данных, незаконный доступ к системам и онлайн-мошенничество, являются уголовными преступлениями. Пользователи, злоупотребляющие DumaSafeGuide в таких целях, могут понести гражданскую и уголовную ответственность согласно этому закону." },
          reporting: { heading: "Сообщение о нарушениях", body: "Если вы столкнулись с контентом или поведением пользователя на этой платформе, нарушающим RA 10175 или другие применимые законы, немедленно сообщите об этом через контакты администратора платформы или напрямую в отдел по киберпреступлениям Национального бюро расследований." },
        },
        disclaimer: {
          tag: "Отказ от ответственности", title: "Ограничение ответственности",
          noGuarantee: { heading: "Отсутствие гарантии реагирования", body: "DumaSafeGuide является вспомогательным средством для информирования и координации. Он не гарантирует время экстренного реагирования или результаты. В ситуациях, угрожающих жизни, пользователи всегда должны напрямую обращаться в официальные экстренные службы (911, местный CDRRMO)." },
          availability: { heading: "Доступность платформы", body: "Мы стремимся обеспечить высокую доступность, но не можем гарантировать бесперебойный доступ во время экстремальных бедствий, которые могут повлиять на интернет-инфраструктуру. Всегда имейте автономные планы на случай ЧС и контакты уровня барангая в качестве резервного варианта." },
          accuracy: { heading: "Точность информации", body: "Хотя мы стремимся поддерживать всю информацию в актуальном состоянии, контактные номера, данные об учреждениях и рекомендации по безопасности могут изменяться. Всегда проверяйте важную информацию непосредственно в соответствующем учреждении, прежде чем действовать на её основе." },
        },
      },
      acceptTitle: "✓ Подразумеваемое согласие",
