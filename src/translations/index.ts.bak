    terms: {
      breadcrumbResources: "Mga Mapagkukunan",
      breadcrumbCurrent: "Mga Tuntunin ng Paggamit",
      eyebrow: "Legal",
      titleLine1: "Mga Tuntunin ng",
      titleAccent: "Paggamit",
      sub: "Ang mga patakaran, responsibilidad, at legal na balangkas na namamahala sa paggamit ng DumaSafeGuide, kasama ang naaangkop na batas ng Pilipinas.",
      meta: "Petsa ng Pagkakaroon ng Bisa: Enero 1, 2025 · Huling Update: Hunyo 2025",
      tocLabel: "Pumunta sa Seksyon",
      sections: {
        responsibilities: {
          tag: "Asal ng User", title: "Responsibilidad ng User",
          accurate: { heading: "Tumpak na Impormasyon", body: "Kailangang magbigay ang mga user ng totoo at tumpak na impormasyon kapag nagsusumite ng ulat ng insidente, tip sa emerhensiya, o anumang nilalaman sa pamamagitan ng DumaSafeGuide. Ang sadyang mga huwad na ulat na nagdudulot ng hindi kinakailangang tugon sa emerhensiya ay maaaring maging kriminal na paglabag sa ilalim ng batas ng Pilipinas." },
          appropriate: { heading: "Angkop na Paggamit", body: "Ang plataporma na ito ay para lamang sa paghahanda sa sakuna, pag-uugnay ng tugon sa emerhensiya, at kaligtasan ng komunidad. Mahigpit na ipinagbabawal ang paggamit ng plataporma na ito para sa personal na alitan, panliligalig, o anumang layunin na walang kinalaman sa kaligtasang pampubliko." },
          security: { heading: "Seguridad ng Account", body: "Kung binigyan ng rehistradong account, responsibilidad ng user na panatilihin ang pagiging kumpidensyal ng kanilang mga kredensyal. Anumang hindi awtorisadong paggamit ng account ay dapat agad na iulat sa mga administrator ng DumaSafeGuide." },
        },
        privacy: {
          tag: "Datos at Privacy", title: "Patakaran sa Privacy",
          collect: { heading: "Datos na Kinokolekta Namin", body: "Maaaring kolektahin ng DumaSafeGuide ang datos ng lokasyon, impormasyon sa pakikipag-ugnayan, at detalye ng insidente na kusang isinumite ng mga user. Ang datos na ito ay ginagamit lamang para sa pag-uugnay ng emerhensiya at hindi ibinebenta o ibinabahagi sa mga komersyal na third party." },
          retention: { heading: "Pagpapanatili ng Datos", body: "Ang mga ulat ng insidente at datos na isinumite ng user ay maaaring panatilihin nang hanggang tatlong (3) taon para sa archival, pagsusuri, at pagpapabuti ng mga serbisyo sa pagtugon sa emerhensiya. Maaaring humiling ang mga user ng pagbura ng kanilang personal na datos sa pamamagitan ng pakikipag-ugnayan sa mga administrator ng plataporma." },
          thirdParty: { heading: "Pagbabahagi sa Third-Party", body: "Ang impormasyon ay maaaring ibahagi sa mga kasosyong ahensya ng gobyerno (CDRRMO, BFP, PNP, Philippine Red Cross) para lamang sa layuning pag-uugnay ng emerhensiya. Walang datos na ibinabahagi sa mga pribadong komersyal na entidad nang walang malinaw na pahintulot ng user." },
        },
        ra10175: {
          tag: "Legal na Balangkas", title: "Buod ng RA 10175",
          act: { heading: "Cybercrime Prevention Act of 2012", body: "Ang Republic Act 10175, o ang Cybercrime Prevention Act of 2012, ay namamahala sa responsableng paggamit ng mga online na plataporma sa Pilipinas. Ganap na sumusunod ang DumaSafeGuide sa batas na ito." },
          prohibited: { heading: "Ipinagbabawal na Online na Gawain", body: "Sa ilalim ng RA 10175, ang mga gawain tulad ng cyber libel, identity theft, ilegal na pag-access sa mga sistema, at online fraud ay mga kriminal na paglabag. Ang mga user na maling gumamit ng DumaSafeGuide para sa mga ganitong layunin ay maaaring humarap sa sibil at kriminal na pananagutan sa ilalim ng Batas na ito." },
          reporting: { heading: "Pag-uulat ng mga Paglabag", body: "Kung makakita ka ng anumang nilalaman o asal ng user sa plataporma na ito na lumalabag sa RA 10175 o iba pang naaangkop na batas, iulat ito agad sa pamamagitan ng admin contact ng plataporma o direkta sa National Bureau of Investigation Cybercrime Division." },
        },
        disclaimer: {
          tag: "Mga Disclaimer", title: "Limitasyon ng Pananagutan",
          noGuarantee: { heading: "Walang Garantiya ng Tugon", body: "Ang DumaSafeGuide ay isang tulong sa impormasyon at pag-uugnay. Hindi ito ginagarantiyahan ang oras ng tugon sa emerhensiya o mga resulta. Dapat palaging direktang makipag-ugnayan ang mga user sa opisyal na serbisyong pang-emerhensiya (911, lokal na CDRRMO) sa mga sitwasyong nagbabanta sa buhay." },
          availability: { heading: "Availability ng Plataporma", body: "Nagsusumikap kami para sa mataas na availability ngunit hindi namin magagarantiyahan ang walang patid na access sa panahon ng matinding kaganapan ng sakuna na maaaring makaapekto sa internet infrastructure. Palaging magkaroon ng offline na emergency plan at mga kontak sa antas ng barangay bilang backup." },
          accuracy: { heading: "Katumpakan ng Impormasyon", body: "Habang nagsusumikap kaming panatilihing updated ang lahat ng impormasyon, maaaring magbago ang mga numero ng contact, detalye ng ahensya, at mga gabay sa kaligtasan. Palaging i-verify ang mahalagang impormasyon nang direkta sa kaugnay na ahensya bago kumilos base rito." },
        },
      },
      acceptTitle: "✓ Ipinapalagay na Pagtanggap",
      acceptBody: "Sa pag-access at paggamit ng DumaSafeGuide, sumasang-ayon ka sa mga Tuntunin ng Paggamit na ito at sa Patakaran sa Privacy nang buo. Ang patuloy na paggamit ay bumubuo ng patuloy na pagtanggap.",
      acceptBadge: "Sumusunod sa RA 10175",
      ctaHeading: "Kailangan mo bang mag-report ng emerhensiya?",
      ctaSub: "Huwag maghintay — gamitin ang incident reporting form para agad na maabisuhan ang mga lokal na responder.",
      ctaBtn: "Mag-report Ngayon",
    },
  },

