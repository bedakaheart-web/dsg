    },
    terms: {
      breadcrumbResources: "Mga Kapanguhaan",
      breadcrumbCurrent: "Mga Termino sa Paggamit",
      eyebrow: "Legal",
      titleLine1: "Mga Termino sa",
      titleAccent: "Paggamit",
      sub: "Ang mga lagda, responsibilidad, ug legal nga balangkas nga nagdumala sa paggamit sa DumaSafeGuide, lakip ang aplikableng balaod sa Pilipinas.",
      meta: "Petsa nga Magsugod ang Bisa: Enero 1, 2025 · Kataposang Update: Hunyo 2025",
      tocLabel: "Adto sa Seksyon",
      sections: {
        responsibilities: {
          tag: "Panggawi sa User", title: "Responsibilidad sa User",
          accurate: { heading: "Tukma nga Impormasyon", body: "Kinahanglan nga maghatag ang mga user og tinuod ug tukma nga impormasyon kung magsumite og report sa insidente, tip sa emerhensya, o bisan unsang content pinaagi sa DumaSafeGuide. Ang tinuyo nga bakak nga report nga makapahinabo og dili kinahanglan nga tubag sa emerhensya mahimong usa ka kriminal nga sala ubos sa balaod sa Pilipinas." },
          appropriate: { heading: "Hustong Paggamit", body: "Kini nga plataporma alang lamang sa pag-andam sa katalagman, pagkoordinar sa tubag sa emerhensya, ug kaluwasan sa komunidad. Mahigpit nga gidili ang paggamit niini nga plataporma para sa personal nga panagbangi, paghasi, o bisan unsang katuyoan nga walay kalabutan sa kaluwasan sa publiko." },
          security: { heading: "Seguridad sa Account", body: "Kung gihatagan og rehistradong account, responsable ang mga user sa pagpanalipod sa pagkakompidensyal sa ilang mga kredensyal. Bisan unsang dili awtorisadong paggamit sa account kinahanglan dayon nga ireport sa mga administrator sa DumaSafeGuide." },
        },
        privacy: {
          tag: "Datos ug Privacy", title: "Palisiya sa Privacy",
          collect: { heading: "Datos nga Among Gikolekta", body: "Ang DumaSafeGuide mahimong mangolekta og datos sa lokasyon, impormasyon sa pakigkontak, ug detalye sa insidente nga kinabubut-on nga gisumite sa mga user. Kini nga datos gigamit lamang alang sa pagkoordinar sa emerhensya ug wala ibaligya o ibahin sa mga komersyal nga third party." },
          retention: { heading: "Pagtipig sa Datos", body: "Ang mga report sa insidente ug datos nga gisumite sa user mahimong tipigan sulod sa tulo (3) ka tuig alang sa archival, pagsusi, ug pagpaayo sa mga serbisyo sa tubag sa emerhensya. Ang mga user mahimong mangayo og pagpapapas sa ilang personal nga datos pinaagi sa pagkontak sa mga administrator sa platform." },
          thirdParty: { heading: "Pagbahin sa Third-Party", body: "Ang impormasyon mahimong ibahin sa mga kasosyo nga ahensya sa gobyerno (CDRRMO, BFP, PNP, Philippine Red Cross) para lamang sa katuyoan sa pagkoordinar sa emerhensya. Walay datos nga gibahin sa mga pribadong komersyal nga entidad nga walay tin-aw nga pagtugot sa user." },
        },
        ra10175: {
          tag: "Legal nga Balangkas", title: "Summary sa RA 10175",
          act: { heading: "Cybercrime Prevention Act of 2012", body: "Ang Republic Act 10175, o ang Cybercrime Prevention Act of 2012, nagdumala sa responsableng paggamit sa mga online nga plataporma sa Pilipinas. Ang DumaSafeGuide naglihok nga hingpit nga nagsunod niini nga balaod." },
          prohibited: { heading: "Gidili nga Online nga mga Buhat", body: "Ubos sa RA 10175, ang mga buhat sama sa cyber libel, identity theft, iligal nga pag-access sa mga sistema, ug online fraud kriminal nga mga sala. Ang mga user nga mag-abuso sa DumaSafeGuide para niini nga mga katuyoan mahimong atubangon ang sibil ug kriminal nga responsibilidad ubos niini nga Batas." },
          reporting: { heading: "Pagreport og mga Paglapas", body: "Kung nakit-an nimo ang bisan unsang content o panggawi sa user niini nga plataporma nga naglapas sa RA 10175 o uban pang aplikableng balaod, ireport kini dayon pinaagi sa admin contact sa plataporma o direkta sa National Bureau of Investigation Cybercrime Division." },
        },
        disclaimer: {
          tag: "Mga Disclaimer", title: "Limitasyon sa Responsibilidad",
          noGuarantee: { heading: "Walay Garantiya sa Tubag", body: "Ang DumaSafeGuide usa ka tabang sa impormasyon ug pagkoordinar. Wala kini nagagarantiya sa oras sa tubag sa emerhensya o mga resulta. Kinahanglan nga direkta gyud nga makigkontak ang mga user sa opisyal nga serbisyo sa emerhensya (911, lokal nga CDRRMO) sa mga sitwasyon nga makahulga sa kinabuhi." },
          availability: { heading: "Availability sa Platform", body: "Naningkamot kami alang sa taas nga availability apan dili namo magarantiya ang walay pagkabalda nga access sa panahon sa grabe nga katalagman nga mahimong makaapekto sa internet infrastructure. Kanunay nga adunay offline nga emergency plan ug mga kontak sa lebel sa barangay isip backup." },
          accuracy: { heading: "Katukma sa Impormasyon", body: "Samtang naningkamot kami nga tipigan nga updated ang tanan nga impormasyon, ang mga numero sa kontak, detalye sa ahensya, ug mga giya sa kaluwasan mahimong mausab. Kanunay nga i-verify ang importanteng impormasyon direkta sa may kalabutan nga ahensya sa dili pa molihok base niini." },
        },
      },
      acceptTitle: "✓ Gipasabot nga Pagdawat",
      acceptBody: "Pinaagi sa pag-access ug paggamit sa DumaSafeGuide, mouyon ka niini nga mga Termino sa Paggamit ug sa Palisiya sa Privacy sa hingpit. Ang padayon nga paggamit nagpasabot sa nagpadayon nga pagdawat.",
      acceptBadge: "Nagsunod sa RA 10175",
      ctaHeading: "Kinahanglan ba nimong mag-report og emerhensya?",
      ctaSub: "Ayaw paghulat — gamita ang incident reporting form aron dayon mapahibalo ang lokal nga mga responder.",
