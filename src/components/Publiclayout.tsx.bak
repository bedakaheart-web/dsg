// src/components/PublicLayout.tsx
//
// Wraps public-facing pages (Homepage, Map, Directory, SafetyTips, Resources)
// with the shared Navbar and Footer.
//
// ⚠️  This is ONLY used for public routes in App.tsx.
//     Citizen / Responder / Admin dashboards are NOT touched.
//     Navbar and Footer are hidden on /login and /signup — those pages
//     have their own internal navigation.

import { useEffect } from "react";
import { useLocation } from "react-router-dom";
import Navbar from "./Navbar";

// ── Pages that manage their own layout (no shared Navbar / Footer) ────────────
const AUTH_PATHS = ["/login", "/signup", "/forgot-password"];

// ── Footer ────────────────────────────────────────────────────────────────────
function PublicFooter() {
  return (
    <>
      <style>{`
        .pf-root {
          position: relative;
          z-index: 2;
          background: transparent;
          border-top: 1px solid rgba(0, 200, 224, 0.10);
          padding: 48px 5% 28px;
          font-family: 'Inter', sans-serif;
          color: rgba(168, 216, 255, 0.45);
          width: 100%;
          box-sizing: border-box;
        }
        .pf-inner {
          max-width: 1100px;
          margin: 0 auto;
          display: grid;
          grid-template-columns: 1.6fr 1fr 1fr 1fr;
          gap: 40px 32px;
        }
        .pf-brand-name {
          font-family: 'Poppins', sans-serif;
          font-size: 18px;
          font-weight: 700;
          color: #fff;
          letter-spacing: -0.02em;
          margin-bottom: 10px;
        }
        .pf-brand-name span { color: #3b82f6; }
        .pf-brand-desc {
          font-size: 12.5px;
          line-height: 1.7;
          color: rgba(168, 216, 255, 0.40);
          max-width: 220px;
        }
        .pf-emergency {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          margin-top: 16px;
          background: rgba(232, 55, 42, 0.10);
          border: 1px solid rgba(232, 55, 42, 0.25);
          border-radius: 8px;
          padding: 8px 14px;
          text-decoration: none;
          font-size: 12px;
          font-weight: 600;
          color: #e8372a;
          transition: background 0.2s, border-color 0.2s;
        }
        .pf-emergency:hover {
          background: rgba(232, 55, 42, 0.18);
          border-color: rgba(232, 55, 42, 0.45);
        }
        .pf-col-title {
          font-size: 10px;
          font-weight: 700;
          letter-spacing: 0.18em;
          text-transform: uppercase;
          color: rgba(168, 216, 255, 0.30);
          margin-bottom: 14px;
        }
        .pf-col-links {
          display: flex;
          flex-direction: column;
          gap: 9px;
          list-style: none;
          margin: 0; padding: 0;
        }
        .pf-col-links a {
          font-size: 13px;
          color: rgba(168, 216, 255, 0.45);
          text-decoration: none;
          transition: color 0.18s;
        }
        .pf-col-links a:hover { color: rgba(168, 216, 255, 0.85); }
        .pf-divider {
          max-width: 1100px;
          margin: 36px auto 0;
          height: 1px;
          background: linear-gradient(90deg, transparent, rgba(0, 200, 224, 0.10), transparent);
        }
        .pf-bottom {
          max-width: 1100px;
          margin: 18px auto 0;
          display: flex;
          align-items: center;
          justify-content: space-between;
          flex-wrap: wrap;
          gap: 10px;
          font-size: 11.5px;
          color: rgba(168, 216, 255, 0.28);
        }
        .pf-bottom-live {
          display: flex;
          align-items: center;
          gap: 6px;
          font-size: 11px;
          font-weight: 600;
          letter-spacing: 0.10em;
          text-transform: uppercase;
          color: rgba(46, 204, 143, 0.55);
        }
        .pf-bottom-dot {
          width: 5px; height: 5px;
          border-radius: 50%;
          background: #2ECC8F;
          animation: pf-pulse 2s ease-in-out infinite;
        }
        @keyframes pf-pulse {
          0%, 100% { opacity: 1; }
          50%       { opacity: 0.4; }
        }
        @media (max-width: 860px) {
          .pf-inner { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 520px) {
          .pf-inner { grid-template-columns: 1fr; gap: 28px; }
          .pf-root  { padding: 36px 5% 24px; }
        }
      `}</style>
      <footer className="pf-root">
        <div className="pf-inner">
          {/* Brand column */}
          <div>
            <div className="pf-brand-name">
              DumaSafe<span>Guide</span>
            </div>
            <p className="pf-brand-desc">
              A centralized emergency response and safety platform for the
              City of Gentle People — Dumaguete City.
            </p>
            <a href="tel:911" className="pf-emergency">
              🚨 Emergency — 911
            </a>
          </div>

          {/* Navigate column */}
          <div>
            <div className="pf-col-title">Navigate</div>
            <ul className="pf-col-links">
              <li><a href="/#/">Home</a></li>
              <li><a href="/#/map">Safety Map</a></li>
              <li><a href="/#/directory">Directory</a></li>
              <li><a href="/#/safetytips">Safety Tips</a></li>
            </ul>
          </div>

          {/* Resources column */}
          <div>
            <div className="pf-col-title">Resources</div>
            <ul className="pf-col-links">
              <li><a href="/#/resources">Emergency Contacts</a></li>
              <li><a href="/#/incident-alerts">Incident Alerts</a></li>
              <li><a href="/#/report">File a Report</a></li>
              <li><a href="/#/signup">Create Account</a></li>
            </ul>
          </div>

          {/* Info column */}
          <div>
            <div className="pf-col-title">Information</div>
            <ul className="pf-col-links">
              <li><a href="/#/about">About</a></li>
              <li><a href="/#/login">Login</a></li>
            </ul>
          </div>
        </div>

        <div className="pf-divider" />

        <div className="pf-bottom">
          <span>© {new Date().getFullYear()} DumaSafeGuide · Dumaguete City</span>
          <span className="pf-bottom-live">
            <span className="pf-bottom-dot" />
            System Online
          </span>
        </div>
      </footer>
    </>
  );
}

// ── PublicLayout ──────────────────────────────────────────────────────────────

interface PublicLayoutProps {
  children: React.ReactNode;
  /** Pass true for the Homepage — it manages its own top spacing internally */
  isHomepage?: boolean;
}

export default function PublicLayout({ children, isHomepage = false }: PublicLayoutProps) {
  const location = useLocation();

  // Scroll to top on route change
  useEffect(() => {
    window.scrollTo(0, 0);
  }, [location.pathname]);

  // Hide shared Navbar + Footer on auth pages — they have their own internal nav
  const isAuthPage = AUTH_PATHS.includes(location.pathname);

  if (isAuthPage) {
    return (
      <div style={{ minHeight: "100vh", background: "transparent" }}>
        {children}
      </div>
    );
  }

  return (
    <div style={{ display: "flex", flexDirection: "column", minHeight: "100vh", background: "transparent" }}>
      {/* Navbar sits on top of everything via position:fixed — no extra div needed */}
      <Navbar />

      {/*
        Main content area.
        - isHomepage: no paddingTop because the homepage hero is designed to sit
          behind / beneath the transparent navbar intentionally.
        - All other public pages: paddingTop:70px to clear the fixed navbar height.
      */}
      <main style={{
        flex: 1,
        background: "transparent",
        paddingTop: isHomepage ? 0 : "70px",
        position: "relative",
        zIndex: 1,
      }}>
        {children}
      </main>

    <Footer />
    </div>
  );
}